{
  "name": "ubuntu-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Yoni Shieber — portfolio as an Ubuntu desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/assemble-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fetch-repos": "tsx scripts/fetch-repos.ts",
    "deploy": "npm run build && npx --yes wrangler@3 pages deploy site --project-name=shieber-net --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
